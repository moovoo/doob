---
# clang-tidy configuration for doob (Qt6 Widgets desktop app, C++17).
#
# Checks are enabled by family so that checks added by newer clang-tidy
# releases are picked up automatically. Individual exclusions mark checks
# that either fight Qt's conventions or are pure noise for this code base:
#
#   - QObject parent/child ownership: smart-pointer checks
#     (modernize-use-resource-ptr, cppcoreguidelines-owning-smartpointer, ...)
#     would fight Qt's ownership model, so only a few safe cppcoreguidelines
#     checks are enabled individually instead of the whole family.
#   - Qt idiom: Q_OBJECT classes keep their `public:` sections after the
#     macro (redundant-access-specifiers), enums keep their default size
#     (enum-size), and widget ids are `inline static const QString`
#     (throwing-static-initialization).
#   - Qt slots keep their (often unused) parameter lists, so
#     misc-unused-parameters is off; (id, index) style APIs are deliberate,
#     so bugprone-easily-swappable-parameters is off.
#   - MOC-generated signal/slot definitions name their parameters _t1,
#     _t2, ..., so readability-inconsistent-declaration-parameter-name
#     fires on every named signal declared in a file the moc compiles.
#   - This project builds without exceptions in practice, so the
#     exception-related bugprone checks are off.
#
# Test files are matched by tests/.clang-tidy (a relaxed variant of this
# file); clang-tidy picks the closest .clang-tidy next to each source file.
#
# Usage (compile_commands.json is generated by the build):
#   cmake -S . -B build
#   clang-tidy -p build path/to/file.cpp
#
# Every commit must be checked with clang-tidy (if available); see AGENTS.md.

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-integer-division,
  -bugprone-throwing-static-initialization,
  -bugprone-unhandled-exception-at-new,
  -bugprone-unhandled-exception-at-range,
  clang-analyzer-*,
  -clang-analyzer-optin.*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  cppcoreguidelines-pro-bounds-constant-array-index,
  cppcoreguidelines-pro-bounds-pointer-arithmetic,
  cppcoreguidelines-pro-type-const-cast,
  cppcoreguidelines-pro-type-reinterpret-cast,
  modernize-*,
  -modernize-use-auto,
  -modernize-use-nodiscard,
  -modernize-use-resource-ptr,
  -modernize-use-trailing-return-type,
  misc-*,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-copyable-objects,
  -misc-non-private-member-variables-in-classes,
  -misc-unused-functions,
  -misc-unused-parameters,
  performance-*,
  -performance-avoid-excessive-padding,
  -performance-enum-size,
  readability-*,
  -readability-avoid-const-params-in-decls,
  -readability-braces-around-controls,
  -readability-braces-around-statements,
  -readability-convert-member-functions-to-static,
  -readability-identifier-length,
  -readability-identifier-naming,
  -readability-inconsistent-declaration-parameter-name,
  -readability-magic-numbers,
  -readability-redundant-access-specifiers,
  portability-*

# Only warn inside project sources/headers, not in Qt system headers or the
# build tree (MOC-generated code is exempt from style rules).
HeaderFilterRegex: 'doob/(tests/)?[^/]+\\.(h|cpp)$'

# Advisory: the tool reports warnings, the gate is the commit review.
WarningsAsErrors: ''
